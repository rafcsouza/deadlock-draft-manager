# Copie para .env.local e preencha o que quiser usar. O .env.local fica fora do git.
# Tudo aqui é opcional: sem nada, o site funciona com os valores padrão.

# Chave da API do Deadlock (https://deadlock-api.com): aumenta o limite de partidas buscadas na Steam.
DEADLOCK_API_KEY=

# Onde fica o banco SQLite (padrão: data/app.db).
# DATABASE_PATH=

# Programa de ingest do Deadlock no mesmo PC do site (padrão: %LOCALAPPDATA%\deadlock-api-ingest\deadlock-api-ingest.exe).
# Quando a API ainda não tem uma partida, o site roda o ingest na hora em vez de esperar o ciclo dele.
# DEADLOCK_INGEST_PATH=

# Lista de heróis (padrão: https://api.deadlock-api.com/v1/assets/heroes).
# HEROES_API_URL=
